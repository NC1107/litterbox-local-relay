# Copy to .env and fill in. Never commit your real .env or the APNs key.

# Base domain for the Traefik host rule: litterbox-relay.<DOMAIN>.
# DOMAIN=npc-server.top

# Guards the /admin endpoints (list + revoke keys), which are reachable from the host only.
# At least 32 bytes, or the relay refuses to start. Leave blank to disable admin entirely.
# Generate with: openssl rand -base64 32
RELAY_ADMIN_TOKEN=

# --- APNs (iOS), token-based (.p8) auth. All four are required together. ---
# Put the .p8 file next to docker-compose.yml as apns-auth-key.p8.
RELAY_APNS_KEY_ID=
RELAY_APNS_TEAM_ID=
RELAY_APNS_BUNDLE_ID=top.npcserver.whiskerlocal
# true talks to the production gateway (TestFlight and App Store builds). false talks to the
# sandbox gateway that debug builds register against.
RELAY_APNS_PRODUCTION=true

# --- FCM (Android), optional ---
# Not wired into docker-compose.yml. To add Android later, mount the Firebase service-account
# JSON into the container and set RELAY_FCM_CREDENTIALS_FILE to its path there.

# Optional: pin a specific image instead of :latest
# RELAY_IMAGE=ghcr.io/nc1107/litterbox-local-relay:v1.0.0

# Optional tuning (defaults shown):
# RELAY_TRUSTED_PROXIES=...         # CIDRs whose X-Forwarded-For is believed; defaults to
#                                   # Cloudflare's published ranges plus private ranges
# RELAY_REGISTER_PER_HOUR=5         # per-address registration rate (IPv6 counts as a /64)
# RELAY_REGISTER_BURST=3
# RELAY_REGISTER_GLOBAL_PER_HOUR=60 # registrations from everywhere together
# RELAY_REGISTER_GLOBAL_BURST=20
# RELAY_MAX_REGISTRATIONS=10000     # unrevoked keys at any time
# RELAY_SEND_IP_PER_MINUTE=120      # per-address, checked before the key is looked up
# RELAY_SEND_IP_BURST=60
# RELAY_SEND_PER_MINUTE=120         # per-key send rate, counted in messages
# RELAY_SEND_BURST=200
# RELAY_TOKEN_PER_MINUTE=6          # messages to one device token
# RELAY_TOKEN_BURST=10
# RELAY_APNS_PER_MINUTE=600         # relay-wide APNs budget
# RELAY_APNS_BURST=200
# RELAY_APNS_CONCURRENCY=8          # simultaneous requests to APNs
# RELAY_ADMIN_FAIL_PER_MINUTE=5     # failed admin attempts per address
# RELAY_MAX_MESSAGES=100            # device tokens per /v1/send request
# RELAY_MAX_TOKENS_PER_KEY=50       # device tokens one server may hold (a token has up to 3 servers)
# RELAY_TOKEN_RETENTION_DAYS=90     # unused token bindings are pruned after this
